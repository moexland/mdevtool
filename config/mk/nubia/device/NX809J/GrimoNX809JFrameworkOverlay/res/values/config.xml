<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The panel has 60, 90, 120 and 144 Hz modes. The stock vendor overlay
         (android.overlay.target) sets a default of 120 and a peak of 240; stock firmware
         ignores both because its own controller bypasses DisplayModeDirector.

         0 casts no default vote, as in the stock framework-res. A default of 120 would cap
         the render rate of everything that doesn't request a rate explicitly. -->
    <integer name="config_defaultRefreshRate">0</integer>

    <!-- The highest mode. 240 selects the same modes, but Settings shows Smooth Display as
         off unless the peak equals the highest mode. -->
    <integer name="config_defaultPeakRefreshRate">144</integer>

    <!-- The panel's gamma differs between refresh rates. On dark content at low brightness
         60 Hz is visibly brighter than 144 Hz, so every idle-timer switch shows as a flash.
         At or below the brightness threshold the framework stays on one rate. With Smooth
         Display off the peak vote outranks this one and the panel stays at 60 Hz.

         The threshold is 160 on the 0-255 scale, roughly 91% of the brightness slider. It
         is where the stock controller stops dropping the rate in dark mode (100 in light
         mode); it reads the same scale from the screen_brightness setting. On this panel
         the flash is obvious at three quarters of the slider and nearly gone at seven
         eighths, so the threshold sits just above the range where it shows.

         -1 leaves ambient light out of the decision. -->
    <integer-array name="config_brightnessThresholdsOfPeakRefreshRate">
        <item>160</item>
    </integer-array>
    <integer-array name="config_ambientThresholdsOfPeakRefreshRate">
        <item>-1</item>
    </integer-array>
    <integer name="config_defaultRefreshRateInZone">144</integer>

    <!-- Shows the Tap to wake switch in Settings. The stock value is false: the stock gesture
         app has a switch of its own. GrimoNX809JGesture follows this one instead. -->
    <bool name="config_supportDoubleTapWake">true</bool>
</resources>
