// Fan and liquid cooling control for NX809J, through the stock kernel drivers.
android_app {
    name: "GrimoNX809JCooling",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    static_libs: [
        "androidx.preference_preference",
        "SettingsLibCategory",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibSelectorWithWidgetPreference",
    ],
    platform_apis: true,
    min_sdk_version: "36",
    // The stock vendor policy lets platform_app reach the fan and pump nodes and read the
    // thermal zones.
    certificate: "platform",
    system_ext_specific: true,
}
